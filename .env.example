# Customer CloudFront URL: https://d25iiefhi451d5.cloudfront.net.
PUBLIC_SITE_URL=https://d25iiefhi451d5.cloudfront.net
# WhatsApp business number in international format (digits only, no leading +).
VITE_RSVP_WHATSAPP_NUMBER=971552789169
# Existing creator pass form (responder URL; edit_requested removed).
VITE_CREATOR_PASS_GOOGLE_FORM_URL=https://docs.google.com/forms/d/1VvAsWM2fEU_4NILdJvtKy0D4cPkzTRbG9ODfe7bTwcM/viewform
# Copy the numeric entry ID logged by connectExistingCreatorPassForm in Apps Script.
VITE_CREATOR_PASS_EVENT_ENTRY_ID=

# Server-side Amazon SES configuration. Never prefix AWS credentials with VITE_.
AWS_REGION=eu-north-1
SES_FROM_EMAIL=
RSVP_PASSWORD_RESET_FROM=RSVP DXB <noreply@rsvpdxb.com>
# Destination for host, press, newsletter and member application notifications.
RSVP_ADMIN_EMAIL=vinitahirani@rsvpdxb.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only when AWS issued temporary credentials.
AWS_SESSION_TOKEN=

# Optional WhatsApp Cloud API delivery for applicants who opt in on registration.
# The approved template should say "Welcome to RSVP DXB, {{1}}! Your membership application has been received and is under review."
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=vXX.0
WHATSAPP_WELCOME_TEMPLATE_NAME=rsvp_dxb_welcome
WHATSAPP_TEMPLATE_LANGUAGE=en_US
